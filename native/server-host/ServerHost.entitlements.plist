<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Events are the only capability the release build grants. The host
	     itself never automates another application; a tool the user ran may. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
