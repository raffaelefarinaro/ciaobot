{
  "id": "M2-project-exists",
  "tier": "medium",
  "category": "project_create",
  "prompt": "Do I already have a project for building the garden shed? If not, create one.",
  "entry": {
    "kind": "prompt"
  },
  "setup": [],
  "requires": [],
  "timeout_s": 600,
  "checks": [
    {
      "kind": "new_projects",
      "count": 0
    },
    {
      "kind": "answer_contains",
      "any": [
        "garden shed"
      ]
    },
    {
      "kind": "new_files",
      "glob": "memory-vault/projects/**",
      "max": 0
    },
    {
      "kind": "new_tasks",
      "count": 0
    },
    {
      "kind": "answer_excludes",
      "any": [
        "i've created",
        "i created",
        "created a new",
        "don't have a",
        "do not have a",
        "no project for"
      ]
    }
  ]
}
