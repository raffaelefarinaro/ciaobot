<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ciao.server</string>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>local.ciaobot.app</string>
    </array>

    <key>ProgramArguments</key>
    <array>
        <string>{{CIAO_EXECUTABLE}}</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{CIAO_WORKSPACE}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CIAO_WORKSPACE</key>
        <string>{{CIAO_WORKSPACE}}</string>
        <key>CIAO_RUNTIME_ROOT</key>
        <string>{{CIAO_RUNTIME_ROOT}}</string>
        <key>CIAO_PORT</key>
        <string>{{CIAO_PORT}}</string>
        <key>PATH</key>
        <string>{{CIAO_PATH}}</string>
    </dict>

    <!-- Deliberately no LimitLoadToSessionType. It looks like the fix for
         FoundationModels' ModelManagerServices error 1008 (the agent lands in
         gui/<uid> but launchd still reports `spawn type = daemon`, and a
         daemon-spawned process cannot use the model-manager connection).
         Measured: adding `Aqua` does not change the spawn type when the job is
         bootstrapped into gui/<uid>, which is how both `ciao setup` and
         Ciaobot.app load it — so it buys nothing and would additionally stop
         the agent loading on a headless host. Generation crosses into the user
         session from the code side instead; see
         native_sidecar._respond_in_user_session. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{CIAO_WORKSPACE}}/.runtime/ciao.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{CIAO_WORKSPACE}}/.runtime/ciao.stderr.log</string>
</dict>
</plist>
