<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ciao.server</string>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>local.ciaobot.app</string>
    </array>

    <key>ProgramArguments</key>
    <array>
        <string>{{CIAO_EXECUTABLE}}</string>
{{LAUNCHD_PROGRAM_ARGUMENTS}}
    </array>

    <key>WorkingDirectory</key>
    <string>{{CIAO_WORKSPACE}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CIAO_WORKSPACE</key>
        <string>{{CIAO_WORKSPACE}}</string>
        <key>CIAO_RUNTIME_ROOT</key>
        <string>{{CIAO_RUNTIME_ROOT}}</string>
        <key>CIAO_PORT</key>
        <string>{{CIAO_PORT}}</string>
        <key>PATH</key>
        <string>{{CIAO_PATH}}</string>
    </dict>

    <!-- Deliberately no LimitLoadToSessionType: `Aqua` would stop the agent
         loading on a headless host. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- launchd's default soft limit is 256, which a long-running PWA session
         exhausts: every tab, websocket and short-lived poll holds a
         descriptor. Keep the packaged agent's budget aligned with
         ciao.os_support.limits.SERVER_NOFILE_TARGET, which the engine also
         raises at startup. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>{{CIAO_WORKSPACE}}/.runtime/ciao.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{CIAO_WORKSPACE}}/.runtime/ciao.stderr.log</string>
</dict>
</plist>
