# Python bytecode and caches
__pycache__/
*.py[cod]

# Editable install metadata
*.egg-info/

# Virtualenvs
.venv/
venv/

# Frontend dependencies
web/node_modules/
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Sidecar binaries, rebuilt from desktop/native/main.swift by `npm run build:native`.
desktop/src-tauri/binaries/
desktop/src-tauri/permissions/autogenerated/
# The embedded Python runtime is generated by scripts/build-bundled-runtime.sh
# before packaging; never commit the local architecture-specific build output.
desktop/runtime/
# The standalone release verifier is built by the publish workflow.
desktop/installer-verify/target/

# Frontend build output (regenerated by `npm run build` and the Deploy flow;
# vite outDir is ciao/web/static, hashed bundles land in assets/)
ciao/web/static/assets/
# ...and so is the shell that references them. Tracking it bought nothing - the
# bundles it points at are ignored above, so a fresh clone could never serve it
# anyway - while its asset hash changes on every build, which made every pair of
# frontend branches conflict on this one line. The engine 404s cleanly when it
# is absent, packaging globs the filesystem (not git) after `npm run build`, and
# the release gate checks the built shell is coherent before it can ship.
ciao/web/static/index.html

# Python build artifacts
build/
dist/

# Local runtime / package-smoke artifacts (the live runtime lives in the
# operator repo, not here)
.runtime/
.tmp-pytest/

# OS noise
.DS_Store
# Private memory vault data must never be committed to the app repo
memory-vault/
# Operator credentials and provider token caches (e.g. secrets/gws-personal/)
secrets/

# Claude Code session tooling (worktrees, local permission grants)
.claude/
.worktrees/


# Workspace runtime artifacts seeded by `ciao sync-skills` when a dev
# instance runs with this repo as its workspace (canonical copies live
# in ciao/stock/; .agents/ and .codex/ are generated Codex mirrors,
# .opencode/ and opencode.json are the opencode ones)
/.agents/
/.codex/
/.opencode/
/opencode.json
/commands/

# npm/vite/vitest caches created when a command is run from the repo root
# instead of web/ or desktop/. There is no root package.json, so this is only
# ever accidental.
/node_modules/
