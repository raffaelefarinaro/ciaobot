# --- Ciaobot Server (required) ---
PWA_AUTH_TOKEN=                # Dashboard password / pre-shared PWA token (required)
PWA_AUTH_REQUIRED=true         # Password protection; on by default, false only for an unreachable machine

# --- Ciaobot Server (optional) ---
PWA_PORT=8443                  # PWA server port (default: 8443)
PWA_HOST=0.0.0.0               # PWA server host (default: 0.0.0.0)
CIAO_WORKSPACE=.               # Operational workspace root (default: current dir)
CIAO_VAULT_ROOT=memory-vault   # Vault root (default: CIAO_WORKSPACE/memory-vault)
CIAO_RUNTIME_ROOT=.runtime     # Runtime state dir (default: .runtime)

# --- Developer setup (optional) ---
# CIAO_DEV_MODE=true           # Dev controls in Settings, /api/debug/issues, desktop-app rebuild on Restart
# CIAO_APP_REPO=               # Absolute path to the ciaobot checkout; required when the engine was installed (Homebrew, wheel)
# CIAO_LOG_LEVEL=debug         # Root log level (default: info); debug also writes .runtime/server_debug.log surfaced via /api/debug/issues
