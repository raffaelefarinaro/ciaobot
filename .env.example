# --- Ciaobot Server (required) ---
PWA_AUTH_TOKEN=                # Dashboard password / pre-shared PWA token (required)
PWA_AUTH_REQUIRED=true         # Password protection; on by default, false only for an unreachable machine
CIAO_PUSH_CONTACT=mailto:you@example.com # Optional VAPID contact; empty disables Web Push until set

# --- Ciaobot Server (optional) ---
PWA_PORT=8443                  # PWA server port (default: 8443)
PWA_HOST=0.0.0.0               # PWA server host (default: 0.0.0.0)
CIAO_WORKSPACE=.               # Operational workspace root (default: current dir)
CIAO_VAULT_ROOT=memory-vault   # Vault root (default: CIAO_WORKSPACE/memory-vault)
CIAO_RUNTIME_ROOT=.runtime     # Runtime state dir (default: .runtime)
CIAO_RESTART_EXIT_CODE=75      # Exit code that triggers restart loop (default: 75)
CIAO_AUTO_SYNC_ON_START=true   # Auto git pull --rebase on startup (default: true)
CIAO_AUTO_VAULT_INDEX=true     # Regenerate INDEX.md on startup (default: true)

# --- Developer setup (optional) ---
# CIAO_DEV_MODE=true           # Dev controls in Settings, /api/debug/issues, desktop-app rebuild on Restart
# CIAO_APP_REPO=               # Absolute path to the ciaobot checkout; required when the engine was installed (Homebrew, wheel)
# CIAO_LOG_LEVEL=debug         # Root log level (default: info); debug also writes .runtime/server_debug.log surfaced via /api/debug/issues

# --- Provider and model routing (optional) ---
CLAUDE_MODELS=opus,sonnet,haiku,fable # Models shown in the picker
# CIAO_CODEX_BIN=              # Optional absolute Codex CLI path; auth lives in `codex login`
# CIAO_OPENCODE_BIN=           # Optional absolute opencode CLI path; auth lives in `opencode auth login`


# --- Insights and local memory helpers (optional) ---
# CIAO_INSIGHTS_DISABLED=false
# CIAO_INSIGHTS_MODEL=
# CIAO_TRAJECTORIES_DISABLED=false
# CIAO_TRAJECTORY_RETENTION_MONTHS=6
# CIAO_SKILL_EVOLUTION_DISABLED=false


# --- Media upload limits (optional) ---
# CIAO_MAX_IMAGE_BYTES=10485760
# CIAO_MAX_VOICE_BYTES=26214400
# CIAO_MEDIA_TTL_HOURS=72

# --- Push notifications (optional) ---
# CIAO_PUSH_DELAY_SECONDS=30

# --- OpenAI (optional) ---

# --- Voice transcription (optional) ---
# CIAO_TRANSCRIPTION_LOCALE=en-US

# --- Remote PWA proxy (optional) ---
# REMOTE_PWA_URL=
# REMOTE_PWA_TOKEN=

# --- Legacy aliases (removed, no longer read) ---
# Execution mode is fixed at auto for every provider; the old
# CLAUDE_EXECUTION_MODE / CLAUDE_PERMISSION_MODE env vars are ignored.
