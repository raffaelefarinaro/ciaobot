{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ciaobot",
  "version": "0.6.3",
  "identifier": "local.ciaobot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/startup.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {},
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "../../ciao/stock/deploy/face_template.png",
      "../../ciao/stock/deploy/Ciaobot.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/raffaelefarinaro/ciaobot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBRTkzOTQwMUU3MjUyODMKUldTRFVuSWVRRG5wbW5OSmlUakxtTjZYT1ZGcWduMUEwRVh2VFZHN0FKSVpYSnhoeUZOOW9zeG0K"
    }
  }
}
